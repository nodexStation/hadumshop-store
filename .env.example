# ── HADUM Shop — environment (copy to .env.local, never commit real secrets) ──
# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin (server-side only — required in production; change the demo value!)
ADMIN_PASSWORD=change-me-demo-password
ADMIN_SESSION_SECRET=change-me-long-random-string

# Supabase (optional switch — when all three are set, products/orders use Supabase
# instead of the local file database; run supabase/schema.sql first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (NOT configured = not shown as operational in checkout)
# BKASH_TOKENIZED_CHECKOUT_ID=
# NAGAD_MERCHANT_ID=
# SSLCOMMERZ_STORE_ID=
